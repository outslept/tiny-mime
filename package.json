{
  "name": "tiny-mime",
  "version": "0.0.0",
  "description": "Curated mapping between common file extensions and MIME types.",
  "keywords": [
    "extension",
    "file-extension",
    "mime",
    "mime-type",
    "mimetype"
  ],
  "homepage": "https://github.com/outslept/tiny-mime#readme",
  "bugs": {
    "url": "https://github.com/outslept/tiny-mime/issues"
  },
  "license": "MIT",
  "author": "outslept",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outslept/tiny-mime.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  }
}
